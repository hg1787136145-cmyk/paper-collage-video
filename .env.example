# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or real credentials.

export GBRO_VIDEO_PROVIDER="yijia"

# Yijia /v1/videos
export YIJIA_API_BASE="https://api.yijiarj.cn"
export YIJIA_API_KEY="your-yijia-api-key"
export YIJIA_VIDEO_MODEL="omni_flash_nowater"
export YIJIA_VIDEO_SIZE="720x1280"
export YIJIA_VIDEO_DURATION="6"
export YIJIA_DURATION_FIELD="response_format.duration"

# Volcengine TOS, used to turn local still images into public/presigned URLs.
export TOS_ACCESS_KEY_ID="your-volcengine-access-key-id"
export TOS_SECRET_ACCESS_KEY="your-volcengine-secret-access-key"
export TOS_REGION="cn-beijing"
export TOS_BUCKET="your-tos-bucket"
export TOS_URL_MODE="presign"
export TOS_PRESIGN_EXPIRES="86400"

# Alternative to TOS: map a local folder to a public URL base.
# export YIJIA_PUBLIC_ASSET_ROOT="/absolute/path/to/public/assets"
# export YIJIA_PUBLIC_ASSET_BASE_URL="https://example.com/assets/"
